{
  "name": "disposable-lock",
  "version": "2.0.1",
  "description": "A disposable lock controller that wraps navigator.locks",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test:watch": "vitest watch --coverage",
    "test": "vitest run --coverage --coverage.reporter=cobertura --coverage.reporter=text",
    "lint": "npx --node-options='--experimental-strip-types' eslint --flag unstable_native_nodejs_ts_config",
    "build": "tsc --project tsconfig.build.json",
    "clean": "node -e \"for (const d of ['./dist', './TestResults']) fs.rmSync(d, { recursive: true, force: true })\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juner/disposable-lock.git"
  },
  "keywords": [
    "Web",
    "Locks",
    "Web Locks",
    "navigator.locks"
  ],
  "author": "juners",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/juner/disposable-lock/issues"
  },
  "homepage": "https://github.com/juner/disposable-lock#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@vitest/coverage-v8": "^4.0.12",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.12"
  }
}
